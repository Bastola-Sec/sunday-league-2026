rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Teams collection
    match /teams/{teamId} {
      allow read: if true;
      allow write: if isValidId(teamId);
    }

    // Matches collection
    match /matches/{matchId} {
      allow read: if true;
      allow write: if isValidId(matchId);
    }

    // Notifications collection
    match /notifications/{notifId} {
      allow read: if true;
      allow write: if isValidId(notifId);
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
